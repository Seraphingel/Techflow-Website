# ==========================================
# TechFlow - Production .gitignore
# Excludes development tools, scrapers,
# agent artifacts, and editor/system caches.
# ==========================================

# AI Agent & Workspace Metadata
.agents/
skills-lock.json
.gemini/
.cursor/

# Development Scripts, Scratchpads & Scrapers
scratch/
*.py
*.ipynb
*.log
*.tmp
*.bak

# Raw / Source Spreadsheets & Data Dumps
*.xlsx
*.xls
*.csv

# Python Environments & Bytecode Cache
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/

# Node / Package Manager Artifacts (if used)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & IDE Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini